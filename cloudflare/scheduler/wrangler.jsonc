{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "specialcarer-scheduler-preview",
  "main": "worker.ts",
  "compatibility_date": "2026-09-17",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "APP_ENV": "preview",
    "SCHEDULER_ENABLED": "false"
  },
  "services": [
    { "binding": "APP", "service": "specialcarer-preview" }
  ],
  // A checked-in map is NOT an activated trigger. Production activation is separate.
  "triggers": { "crons": [] }
}
