{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "specialcarer-scheduler-rehearsal",
  "main": "worker.ts",
  "compatibility_date": "2026-09-17",
  "workers_dev": false,
  "preview_urls": false,
  // Deliberately still points at the EXISTING specialcarer-preview app, not a
  // new production-secreted Worker. specialcarer-preview has no real database
  // credentials, so any dispatched request either fails cleanly at the app
  // (e.g. auth/config error) or is a genuinely harmless no-op — this step
  // tests only whether Cloudflare's own cron trigger mechanism correctly
  // invokes this Worker's scheduled() handler, not whether the underlying
  // jobs complete successfully against real data. That is a separate,
  // later decision (see docs/cloudflare-hosting-portability.md, "Scheduler
  // cutover").
  "vars": {
    "APP_ENV": "production",
    "SCHEDULER_ENABLED": "true",
    // Only used to construct a well-formed URL object for the request -
    // the actual call routes through the APP service binding below,
    // regardless of this value's host, not real DNS. "app.invalid" is
    // RFC 2606's reserved non-resolving TLD, and is the same placeholder
    // already used in cloudflare/scheduler/worker.test.ts's own "active"
    // fixture - not a real origin, deliberately.
    "APP_ORIGIN": "https://app.invalid"
  },
  "services": [
    { "binding": "APP", "service": "specialcarer-preview" }
  ],
  // Only the three Phase 1 jobs' exact cron expressions, each confirmed
  // unique in cloudflare/scheduler/schedules.ts (no other job shares any of
  // these three strings) - kpi-rollup-hourly, experiment-rollup,
  // dbs-update-service-poll. No financial or destructive job's schedule is
  // present here, by construction, regardless of the enable flag above.
  // Phase 1 Step 1a is complete and confirmed (see
  // docs/cloudflare-hosting-portability.md, "Scheduler cutover"): all three
  // jobs fired naturally and correctly dispatched via the platform's own
  // cron trigger mechanism. Deliberately emptied after confirmation, same
  // convention as cloudflare/scheduler/wrangler.jsonc - a checked-in map is
  // not an activated trigger. Re-populate with exactly
  // ["5 * * * *", "0 5 * * *", "23 6 * * *"] only when deliberately
  // resuming rehearsal or moving to Step 1b; cloudflare/scheduler/
  // rehearsal.test.ts enforces that if these are ever non-empty, they must
  // resolve to exactly the three approved Phase 1 jobs and no others.
  "triggers": { "crons": [] }
}
